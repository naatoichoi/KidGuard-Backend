# Copy to .env on VPS; fill in real values there. Never commit .env.
API_DOMAIN=api.example.com
# Use a strong password >= 16 characters; avoid ; $ and quotes in this template.
DB_PASSWORD=ReplaceWithStrong123Password
# Generate: openssl rand -base64 32
JWT_KEY=REPLACE_WITH_RANDOM_BASE64_32_BYTES
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=parent-sender@example.com
SMTP_PASSWORD=REPLACE_WITH_EMAIL_APP_PASSWORD
